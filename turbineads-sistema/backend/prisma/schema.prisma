generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SOCIO
  GESTOR
  ATENDENTE
}

enum ClientStatus {
  ATIVO
  PENDENTE_PAGAMENTO
  ONBOARDING
  CANCELADO
}

enum PaymentStatus {
  PAGO
  PENDENTE
  ATRASADO
}

enum TaskStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

enum TaskPriority {
  BAIXA
  MEDIA
  ALTA
}

enum PendencyStatus {
  ABERTA
  RESOLVIDA
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  clients        Client[]  @relation("GestorClients")
  tasks          Task[]    @relation("GestorTasks")
  leads          Lead[]    @relation("AtendenteLeads")
  meetings       Meeting[] @relation("ResponsavelMeetings")
}

model Client {
  id             String       @id @default(cuid())
  name           String
  niche          String?
  status         ClientStatus @default(ONBOARDING)
  plan           String?
  monthlyValue   Float?
  dailyAdBudget  Float?
  startDate      DateTime?
  createdAt      DateTime     @default(now())

  gestorId String?
  gestor   User?   @relation("GestorClients", fields: [gestorId], references: [id])

  payments   Payment[]
  tasks      Task[]
  pendencies Pendency[]
}

model Payment {
  id        String        @id @default(cuid())
  amount    Float
  dueDate   DateTime
  status    PaymentStatus @default(PENDENTE)
  paidDate  DateTime?
  createdAt DateTime      @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  status      TaskStatus   @default(PENDENTE)
  priority    TaskPriority @default(MEDIA)
  createdAt   DateTime     @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  gestorId String?
  gestor   User?   @relation("GestorTasks", fields: [gestorId], references: [id])
}

model Pendency {
  id          String         @id @default(cuid())
  description String
  type        String?
  status      PendencyStatus @default(ABERTA)
  createdAt   DateTime       @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  origin    String?
  status    String   @default("novo")
  createdAt DateTime @default(now())

  atendenteId String?
  atendente   User?   @relation("AtendenteLeads", fields: [atendenteId], references: [id])

  meetings Meeting[]
}

model Meeting {
  id        String   @id @default(cuid())
  scheduledAt DateTime
  status    String   @default("agendada")
  notes     String?
  createdAt DateTime @default(now())

  leadId String?
  lead   Lead?  @relation(fields: [leadId], references: [id])

  responsavelId String?
  responsavel   User?  @relation("ResponsavelMeetings", fields: [responsavelId], references: [id])
}
