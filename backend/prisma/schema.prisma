generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SOCIO
  GESTOR
  ATENDENTE
  CLIENTE
}

enum ClientStatus {
  ATIVO
  PENDENTE_PAGAMENTO
  ONBOARDING
  CANCELADO
}

enum PaymentStatus {
  PAGO
  PENDENTE
  ATRASADO
}

enum TaskStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

enum TaskPriority {
  BAIXA
  MEDIA
  ALTA
}

enum PendencyStatus {
  ABERTA
  RESOLVIDA
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  clients        Client[]  @relation("GestorClients")
  tasks          Task[]    @relation("GestorTasks")
  leads          Lead[]    @relation("AtendenteLeads")
  meetings       Meeting[] @relation("ResponsavelMeetings")

  // Set only for role = CLIENTE: which client's portal this login can see.
  clientId String?
  client   Client? @relation("ClientPortalUser", fields: [clientId], references: [id])
}

model Client {
  id             String       @id @default(cuid())
  name           String
  niche          String?
  status         ClientStatus @default(ONBOARDING)
  plan           String?
  monthlyValue   Float?
  dailyAdBudget  Float?
  startDate      DateTime?
  notes          String?
  optimizationDay   Int?     // day of month (1-31) the account should be optimized
  activeCreative    String?  // short label for whichever creative is currently live
  createdAt      DateTime     @default(now())

  gestorId String?
  gestor   User?   @relation("GestorClients", fields: [gestorId], references: [id])

  payments    Payment[]
  tasks       Task[]
  pendencies  Pendency[]
  meetings    Meeting[]
  portalUsers User[]         @relation("ClientPortalUser")
  clientLeads ClientLead[]
  files       ClientFile[]
  reports     MonthlyReport[]
}

model Payment {
  id        String        @id @default(cuid())
  amount    Float
  dueDate   DateTime
  status    PaymentStatus @default(PENDENTE)
  paidDate  DateTime?
  createdAt DateTime      @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  status      TaskStatus   @default(PENDENTE)
  priority    TaskPriority @default(MEDIA)
  createdAt   DateTime     @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  gestorId String?
  gestor   User?   @relation("GestorTasks", fields: [gestorId], references: [id])
}

model Pendency {
  id          String         @id @default(cuid())
  description String
  type        String?
  status      PendencyStatus @default(ABERTA)
  createdAt   DateTime       @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  origin    String?
  status    String   @default("novo")
  createdAt DateTime @default(now())

  atendenteId String?
  atendente   User?   @relation("AtendenteLeads", fields: [atendenteId], references: [id])

  meetings Meeting[]
}

model Meeting {
  id        String   @id @default(cuid())
  scheduledAt DateTime
  status    String   @default("agendada") // agendada | solicitada | confirmada | realizada | recusada
  notes     String?
  requestedByClient Boolean @default(false)
  createdAt DateTime @default(now())

  leadId String?
  lead   Lead?  @relation(fields: [leadId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  responsavelId String?
  responsavel   User?  @relation("ResponsavelMeetings", fields: [responsavelId], references: [id])
}

// A client's own mini-CRM — leads the client logs themselves in their portal.
// Separate from the agency's own Lead funnel above.
model ClientLead {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  origin    String?
  status    String   @default("novo")
  notes     String?
  createdAt DateTime @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// Small files (sales scripts, photos) stored inline as base64 — keeps the
// feature working on Railway's ephemeral filesystem without an S3 bucket.
model ClientFile {
  id         String   @id @default(cuid())
  name       String
  mimeType   String
  category   String   @default("OUTRO") // FOTO | SCRIPT | OUTRO
  dataBase64 String   @db.Text
  size       Int
  createdAt  DateTime @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model MonthlyReport {
  id             String   @id @default(cuid())
  month          String   // "2026-09"
  spend          Float?
  impressions    Int?
  clicks         Int?
  leadsCount     Int?
  fechamentos    Int?
  revenue        Float?
  notes          String?
  sourceFileName String?
  createdAt      DateTime @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}
