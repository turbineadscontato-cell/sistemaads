generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SOCIO
  GESTOR
  ATENDENTE
  CLIENTE
  // A patient/end-client of one of our CLIENTE accounts (a therapist reselling
  // the system to their own patients). Scoped to exactly one Patient via
  // User.patientId — never sees anything about the agency or other patients.
  PACIENTE
}

enum ClientStatus {
  ATIVO
  PENDENTE_PAGAMENTO
  ONBOARDING
  CANCELADO
}

enum PaymentStatus {
  PAGO
  PENDENTE
  ATRASADO
}

enum TaskStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

enum TaskPriority {
  BAIXA
  MEDIA
  ALTA
}

enum PendencyStatus {
  ABERTA
  RESOLVIDA
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  // Foto de perfil de cada login (base64 data URL, já redimensionada no
  // navegador antes do envio) — cada usuário troca a própria.
  avatarUrl    String?

  // Nível/patente gamificado do gestor/atendente (só o sócio define, na
  // gestão de usuários) — BRONZE < PRATA < OURO < PLATINA < DRAGAO.
  // Puramente simbólico/motivacional, exibido como um brasão com emoji.
  rank String @default("BRONZE")

  clients        Client[]  @relation("GestorClients")
  tasks          Task[]    @relation("GestorTasks")
  leads          Lead[]    @relation("AtendenteLeads")
  meetings       Meeting[] @relation("ResponsavelMeetings")
  metaConnections MetaConnection[]

  // Set only for role = CLIENTE: which client's portal this login can see.
  clientId String?
  client   Client? @relation("ClientPortalUser", fields: [clientId], references: [id])

  // Set only for role = PACIENTE: which patient record this login can see.
  // Cascades so removing a patient removes their portal login with it.
  patientId String?
  patient   Patient? @relation("PatientPortalUser", fields: [patientId], references: [id], onDelete: Cascade)
}

model Client {
  id             String       @id @default(cuid())
  name           String
  niche          String?
  status         ClientStatus @default(ONBOARDING)
  plan           String?
  monthlyValue   Float?
  dailyAdBudget  Float?
  startDate      DateTime?
  notes          String?
  optimizationDay   Int?     // weekday the account should be optimized every week (0 = domingo … 6 = sábado, same convention as JS Date.getDay())
  // Concrete tracked date for the next otimização (instead of just inferring
  // it from optimizationDay + today's weekday, which could never tell "already
  // done this week" from "still pending"). Seeded from optimizationDay when
  // it's set/changed, then auto-advances +7 dias every time markOptimized is
  // used. lastOptimizedAt is just the visible "fizemos em DD/MM" confirmation
  // for both the agência and o cliente.
  nextOptimizationDate DateTime?
  lastOptimizedAt      DateTime?
  activeCreative    String?  // short label for whichever creative is currently live
  createdAt      DateTime     @default(now())

  // COMPLETO = tráfego pago + sistema. SO_SISTEMA = cliente cancelou o
  // tráfego mas continua pagando só pelo sistema (Pacientes/CRM/agenda/etc).
  // Sócio-only, muda o que aparece no portal (esconde métricas de anúncio).
  planType String @default("COMPLETO") // COMPLETO | SO_SISTEMA

  // White-label do PORTAL DOS PACIENTES desse cliente (não do portal do
  // próprio cliente, que continua com a marca TurbinaADS). O próprio cliente
  // (profissional) configura isso pelo portal dele, self-service — pensado
  // para quando a agência revende o sistema fora do plano de tráfego pago.
  brandName    String?
  logoBase64   String?  @db.Text
  logoMimeType String?

  gestorId String?
  gestor   User?   @relation("GestorClients", fields: [gestorId], references: [id])

  payments     Payment[]
  tasks        Task[]
  pendencies   Pendency[]
  meetings     Meeting[]
  portalUsers  User[]          @relation("ClientPortalUser")
  clientLeads  ClientLead[]
  files        ClientFile[]
  reports      MonthlyReport[]
  patients     Patient[]
  contentPosts ContentPost[]
  adAccounts   AdAccount[]
}

model Payment {
  id        String        @id @default(cuid())
  amount    Float
  dueDate   DateTime
  status    PaymentStatus @default(PENDENTE)
  paidDate  DateTime?
  createdAt DateTime      @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  status      TaskStatus   @default(PENDENTE)
  priority    TaskPriority @default(MEDIA)
  createdAt   DateTime     @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  gestorId String?
  gestor   User?   @relation("GestorTasks", fields: [gestorId], references: [id])
}

model Pendency {
  id          String         @id @default(cuid())
  description String
  type        String?
  status      PendencyStatus @default(ABERTA)
  createdAt   DateTime       @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  origin    String?
  status    String   @default("novo")
  notes     String?
  createdAt DateTime @default(now())

  atendenteId String?
  atendente   User?   @relation("AtendenteLeads", fields: [atendenteId], references: [id])

  meetings Meeting[]
}

model Meeting {
  id        String   @id @default(cuid())
  scheduledAt DateTime
  status    String   @default("agendada") // agendada | solicitada | confirmada | realizada | recusada
  notes     String?
  requestedByClient Boolean @default(false)
  createdAt DateTime @default(now())

  leadId String?
  lead   Lead?  @relation(fields: [leadId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  responsavelId String?
  responsavel   User?  @relation("ResponsavelMeetings", fields: [responsavelId], references: [id])
}

// A client's own mini-CRM — leads the client logs themselves in their portal.
// Separate from the agency's own Lead funnel above.
model ClientLead {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  origin    String?
  status    String   @default("novo")
  notes     String?
  createdAt DateTime @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// Small files (sales scripts, photos) stored inline as base64 — keeps the
// feature working on Railway's ephemeral filesystem without an S3 bucket.
model ClientFile {
  id         String   @id @default(cuid())
  name       String
  mimeType   String
  category   String   @default("OUTRO") // FOTO | SCRIPT | OUTRO
  dataBase64 String   @db.Text
  size       Int
  createdAt  DateTime @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model MonthlyReport {
  id             String   @id @default(cuid())
  month          String   // "2026-09"
  spend          Float?
  impressions    Int?
  clicks         Int?
  leadsCount     Int?
  fechamentos    Int?
  revenue        Float?
  notes          String?
  sourceFileName String?
  createdAt      DateTime @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// The client's own patient/appointment tracker (Trello-style), private to
// the client portal — kept out of staff view by default for patient
// confidentiality (agency staff never needed patient-level health data).
model Patient {
  id            String    @id @default(cuid())
  name          String
  contact       String?
  status        String    @default("avaliacao") // avaliacao | acompanhamento | pausado | encerrado
  sessionValue  Float?
  paymentDueDay Int?      // day of month the patient's fee is due
  paymentStatus String    @default("EM_DIA") // EM_DIA | PENDENTE | ATRASADO
  nextSessionAt DateTime?
  notes         String?
  createdAt     DateTime  @default(now())

  // Recurring weekly attendance pattern (independent of nextSessionAt, which
  // is the next confirmed occurrence). 0=domingo ... 6=sábado. Drives the
  // weekly agenda board — dragging a patient card to another day updates this.
  weekdays    Int[]   @default([])
  sessionTime String? // "HH:MM", the usual time for these weekly sessions

  // Recurring video-call link for this patient's sessions (e.g. a fixed
  // Google Meet room the professional reuses). Just a plain URL — no
  // calendar/Meet API integration; the frontend offers a shortcut that opens
  // meet.google.com/new so the professional can generate a fresh Meet room
  // and paste it back here, rather than typing/thinking one up by hand.
  meetLink String?

  // Contracted session package — how many sessions were sold and, combined
  // with `weekdays` above (how many of those days are marked = sessions per
  // week), used to compute the full calendar of session dates shown to both
  // the professional (PatientsBoard) and the patient (paciente-portal).
  // packageStartDate anchors the calculation; defaults to createdAt when unset.
  packageTotalSessions Int?
  packageStartDate     DateTime?

  // Set by the patient from their own portal when they ask to change their
  // next session — the professional approves (copies into nextSessionAt and
  // clears these) or declines (just clears these) from PatientsBoard.
  requestedSessionAt DateTime?
  requestNote        String?

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  reports    PatientNote[]
  activities PatientActivity[]
  journal    PatientJournalEntry[]
  portalUser User[]                @relation("PatientPortalUser")
}

// Dated log entries per patient — session notes / progress reports written
// by the professional. Private by default: visibleToPatient opts a specific
// entry into showing up in that patient's own portal.
model PatientNote {
  id               String   @id @default(cuid())
  content          String
  visibleToPatient Boolean  @default(false)
  createdAt        DateTime @default(now())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// A task/homework the professional assigns a patient between sessions —
// patient can mark it done from their own portal.
model PatientActivity {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("pendente") // pendente | concluida
  dueDate     DateTime?
  createdAt   DateTime  @default(now())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// The patient's own "como foi seu dia" check-in/diary entry — written by the
// patient, readable by the professional alongside the session notes.
model PatientJournalEntry {
  id        String   @id @default(cuid())
  mood      String? // free-form label chosen by the patient, e.g. "bem", "dificil"
  note      String?
  createdAt DateTime @default(now())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// Marketing/content calendar entries for the client's own social media.
model ContentPost {
  id            String   @id @default(cuid())
  scheduledDate DateTime
  title         String
  theme         String?
  status        String   @default("planejado") // planejado | produzido | publicado
  notes         String?
  createdAt     DateTime @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// One row per Meta (Facebook/Instagram) Ads login the agency has connected.
// Only a sócio can connect; the most recent row is treated as the active
// connection. The token is a long-lived user or system-user token exchanged
// server-side — never the short-lived token the JS SDK hands back.
model MetaConnection {
  id             String    @id @default(cuid())
  accessToken    String    @db.Text
  tokenExpiresAt DateTime?
  metaUserId     String?
  metaUserName   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  connectedById String
  connectedBy   User   @relation(fields: [connectedById], references: [id])
}

// A Meta ad account (act_XXXXXXXXX) discovered through the connection above,
// optionally mapped to one of the agency's clients so campaign metrics can be
// shown on that client's page and scoped to that client's gestor.
model AdAccount {
  id            String   @id @default(cuid())
  metaAccountId String   @unique // "act_123456789"
  name          String
  currency      String?
  accountStatus String? // Meta's own status label, e.g. "ATIVA", "DESATIVADA"
  createdAt     DateTime @default(now())

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])
}
